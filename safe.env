# GWH Harvester Engine — safe environment configuration
# -------------------------------------------------------

# Jupiter Swap API (lite endpoint, v1)
JUP_BASE=https://lite-api.jup.ag/swap/v1
JUP_QUOTE_BASE=https://lite-api.jup.ag/swap/v1

# Jupiter API key (optional for lite endpoint; required for api.jup.ag)
JUP_API_KEY=

# Meteora DLMM data API (concentrated liquidity pools)
METEORA_API_BASE=https://dlmm.datapi.meteora.ag
METEORA_DLMM_BASE=https://dlmm.datapi.meteora.ag

# Meteora Dynamic AMM / CPMM pools
METEORA_DAMM_BASE=https://damm-api.meteora.ag

# Pool filtering — 0 = allow all pools (permissive)
DLMM_MIN_FEE_TVL=0
MIN_POOL_TVL=0
MIN_POOL_VOL=0

# Solana RPC endpoint
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Wallet (base58 public key / private key)
WALLET_PUBKEY=
WALLET_PRIVKEY=

# Hub WebSocket (optional, leave blank to disable)
HUB_URL=

# Harvester timing
HARVEST_INTERVAL_MS=60000

# Pool discovery: how many pools to fetch from each API per cycle
MAX_FETCH_POOLS=100

# Jupiter rate-limit controls:
#   MAX_QUOTE_POOLS  — how many of the top-ranked pools to quote per cycle.
#                      Pools are pre-sorted best-first (volume_24h:desc) by the DLMM API
#                      so you only need to quote the top few. Default: 10.
#   JUP_CALL_DELAY_MS — mandatory pause between consecutive Jupiter quote calls (ms).
#                      At 300ms = ~3 req/s, safely under the free-tier limit. Default: 300.
MAX_QUOTE_POOLS=10
JUP_CALL_DELAY_MS=300

SLIPPAGE_BPS=100
HARVEST_SOL_AMOUNT=0.05
