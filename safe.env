# GWH Harvester Engine — safe environment configuration
# -------------------------------------------------------

# Jupiter Swap API (lite endpoint, v1)
JUP_BASE=https://lite-api.jup.ag/swap/v1
JUP_QUOTE_BASE=https://lite-api.jup.ag/swap/v1

# *** IMPORTANT — GET A FREE API KEY TO ELIMINATE 429s ***
# Register at https://portal.jup.ag (free tier: 60 req/min)
# Set the key here and the 429 rate-limit errors will stop permanently.
JUP_API_KEY=

# Meteora DLMM data API (concentrated liquidity pools)
METEORA_API_BASE=https://dlmm.datapi.meteora.ag
METEORA_DLMM_BASE=https://dlmm.datapi.meteora.ag

# Meteora Dynamic AMM / CPMM pools
METEORA_DAMM_BASE=https://damm-api.meteora.ag

# Pool filtering — 0 = allow all pools (permissive)
DLMM_MIN_FEE_TVL=0
MIN_POOL_TVL=0
MIN_POOL_VOL=0

# Solana RPC endpoint
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Wallet (base58 public key / private key)
WALLET_PUBKEY=
WALLET_PRIVKEY=

# Hub WebSocket (optional, leave blank to disable)
HUB_URL=

# Cycle timing
HARVEST_INTERVAL_MS=60000

# Pool discovery: how many pools to fetch from each API per cycle
MAX_FETCH_POOLS=100

# Jupiter rate-limit controls:
#
#   MAX_QUOTE_POOLS   — Only quote the top N pools per cycle.
#                       Pools are pre-sorted volume_24h:desc so these are the
#                       highest-yield opportunities. Default: 5.
#                       With JUP_API_KEY set you can safely raise this to 20+.
#
#   JUP_CALL_DELAY_MS — Mandatory pause between consecutive Jupiter calls (ms).
#                       2000ms = 0.5 req/s — conservative for unauthenticated lite endpoint.
#                       With JUP_API_KEY set you can lower to 200ms (5 req/s).
#
MAX_QUOTE_POOLS=5
JUP_CALL_DELAY_MS=2000

SLIPPAGE_BPS=100
HARVEST_SOL_AMOUNT=0.05
