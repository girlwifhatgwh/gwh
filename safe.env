# GWH Harvester Engine — safe environment configuration
# -------------------------------------------------------
# Jupiter Swap API (lite endpoint, v1 compatible)
JUP_BASE=https://lite-api.jup.ag/swap/v1
JUP_QUOTE_BASE=https://lite-api.jup.ag/swap/v1

# Jupiter API key (obtain from portal.jup.ag — required for api.jup.ag)
JUP_API_KEY=

# Meteora DLMM data API
METEORA_API_BASE=https://dlmm.datapi.meteora.ag
METEORA_DLMM_BASE=https://dlmm.datapi.meteora.ag

# Pool filtering — set to 0 to allow all pools (permissive DLMM filters)
DLMM_MIN_FEE_TVL=0
MIN_POOL_TVL=0
MIN_POOL_VOL=0

# Solana RPC endpoint
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Wallet (base58 public key / private key)
WALLET_PUBKEY=
WALLET_PRIVKEY=

# Harvester tuning
HARVEST_INTERVAL_MS=60000
MAX_POOLS_PER_CYCLE=50
SLIPPAGE_BPS=100
MIN_PROFIT_LAMPORTS=5000
