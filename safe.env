# GWH Harvester Engine — safe environment configuration
# -------------------------------------------------------

# Jupiter Swap API (lite endpoint, v1)
JUP_BASE=https://lite-api.jup.ag/swap/v1
JUP_QUOTE_BASE=https://lite-api.jup.ag/swap/v1

# Jupiter API key (optional for lite endpoint; get free key at portal.jup.ag)
JUP_API_KEY=

# Meteora DLMM data API (concentrated liquidity pools)
METEORA_API_BASE=https://dlmm.datapi.meteora.ag
METEORA_DLMM_BASE=https://dlmm.datapi.meteora.ag

# Meteora Dynamic AMM / CPMM pools
METEORA_DAMM_BASE=https://damm-api.meteora.ag

# Solana RPC endpoint
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ─── WALLET ───────────────────────────────────────────────
# Private key for signing transactions.
# Accepts EITHER:
#   - base58 string (standard Phantom/Solflare export)
#   - JSON byte array string, e.g. [12,34,...,255]  (Solana CLI keypair file format)
#
# The public key is derived automatically — WALLET_PUBKEY is no longer needed.
# Leave blank to run in dry-run mode (quotes fetched but no transactions sent).
HARVESTER_PRIVATE_KEY=

# Set to true to wait for on-chain confirmation after each swap (slower but safer)
CONFIRM_TX=false

# Pool filtering — 0 = allow all pools (permissive)
DLMM_MIN_FEE_TVL=0
MIN_POOL_TVL=0
MIN_POOL_VOL=0

# Hub WebSocket (optional, leave blank to disable)
HUB_URL=

# Cycle timing
HARVEST_INTERVAL_MS=60000

# Pool discovery: how many pools to fetch from each API per cycle
MAX_FETCH_POOLS=100

# Jupiter rate-limit controls:
#   MAX_QUOTE_POOLS   — Only quote the top N pools (pre-sorted volume_24h:desc).
#                       Raise to 20+ if JUP_API_KEY is set.
#   JUP_CALL_DELAY_MS — Pause between consecutive Jupiter calls (ms).
#                       Lower to 200ms if JUP_API_KEY is set.
MAX_QUOTE_POOLS=10
JUP_CALL_DELAY_MS=300

SLIPPAGE_BPS=100
HARVEST_SOL_AMOUNT=0.05
