# ── Telegram Listener (Telethon) ──────────────────────────────────────────────
# String session generated via: python -c "from telethon.sync import TelegramClient; from telethon.sessions import StringSession; c = TelegramClient(StringSession(), API_ID, API_HASH); c.start(); print(c.session.save())"
TG_SESSION=

# From https://my.telegram.org/apps
TG_API_ID=0
TG_API_HASH=

# ── Telegram Alert Bot ────────────────────────────────────────────────────────
# BotFather token for the bot that sends you alerts
ALERT_BOT_TOKEN=

# Your personal Telegram chat ID (send /start to @userinfobot to find it)
ALERT_CHAT_ID=0

# ── IQ Option Credentials ─────────────────────────────────────────────────────
IQ_EMAIL=
IQ_PASSWORD=

# ── Optional Overrides ────────────────────────────────────────────────────────
# Channel ID to listen to (default: Magic Trader = -1001940077808)
MAGIC_TRADER_CHANNEL=-1001940077808

# Risk per trade as % of balance (default: 5.0)
RISK_PERCENT=5.0

# Minimum stake in dollars (default: 1.0)
MIN_STAKE=1.0

# Maximum base stake in dollars (default: 500.0)
MAX_STAKE=500.0

# Maximum gale stake in dollars (default: 500.0)
MAX_GALE_STAKE=500.0

# Path to trade history JSON (default: trades_db.json next to the script)
# TRADES_FILE=/path/to/trades_db.json
